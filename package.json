    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "discord.js": "^14.21.0",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.31.0",
    "globals": "^15.14.0",
    "vitest": "^2.1.9"
  }
}
