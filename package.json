{
  "name": "sbl-bot",
  "version": "1.0.0",
  "description": "Bot Discord pour SBL",
  "main": "main.js",
  "scripts": {
    "start": "node main.js",
    "deploy": "node deploy-commands.js",
    "dev": "node --watch main.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
